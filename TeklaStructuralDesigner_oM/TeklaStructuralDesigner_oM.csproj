<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>TeklaStructuralDesigner_oM</AssemblyName>
    <RootNamespace>BH.oM.Adapters.TeklaStructuralDesigner</RootNamespace>
    <AssemblyVersion>9.0.0.0</AssemblyVersion>
    <FileVersion>9.2.0.0</FileVersion>
    <Description>https://github.com/BHoM/TeklaStructuralDesigner_Toolkit</Description>
    <Authors>BHoM</Authors>
    <Copyright>Copyright © https://github.com/BHoM</Copyright>
    <Configurations>Debug;Release;Test</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Flat output directory. Without AppendTargetFrameworkToOutputPath the SDK emits
         ..\Build\Debug\net48\, which BHoM's CI and the installer do not expect. -->
    <OutputPath>..\Build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

  <!-- This project deliberately does NOT reference TSD.API.Remoting. BHoM convention is that an
       _oM assembly never depends on an external software API, which is why the TSD enums that
       need to appear on a config object are mirrored here rather than re-exported. -->
  <ItemGroup>
    <Reference Include="Adapter_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Adapter_oM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="BHoM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\BHoM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToBHoM" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' != 'Test'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProgramData)\BHoM\Assemblies" />
  </Target>

</Project>
