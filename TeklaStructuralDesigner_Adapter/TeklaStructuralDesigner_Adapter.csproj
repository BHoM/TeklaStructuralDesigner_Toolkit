<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>TeklaStructuralDesigner_Adapter</AssemblyName>
    <RootNamespace>BH.Adapter.TeklaStructuralDesigner</RootNamespace>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
    <Description>https://github.com/BHoM/TeklaStructuralDesigner_Toolkit</Description>
    <Authors>BHoM</Authors>
    <Copyright>Copyright © https://github.com/BHoM</Copyright>
    <Configurations>Debug;Release;Test</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>..\Build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 26.0.1 is the Remoting API version for TSD 2026 SP1; an API newer than the application fails.
         Only its net48 asset still uses native gRPC, which .NET Framework needs. -->
    <TsdApiVersion>26.0.1</TsdApiVersion>
    <!-- The native gRPC library is 64 bit, as are the hosts (Rhino, Excel). -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Puts the package assets in the output folder for the deployment target below. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TeklaStructuralDesigner_Adapter_Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TeklaStructuralDesigner.RemotingAPI" Version="$(TsdApiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeklaStructuralDesigner_Engine\TeklaStructuralDesigner_Engine.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="..\TeklaStructuralDesigner_oM\TeklaStructuralDesigner_oM.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Adapter_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Adapter_Engine.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Adapter_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Adapter_oM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Analytical_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Analytical_oM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="BHoM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\BHoM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="BHoM_Adapter">
      <HintPath>$(ProgramData)\BHoM\Assemblies\BHoM_Adapter.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="BHoM_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\BHoM_Engine.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Data_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Data_Engine.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Data_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Data_oM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Dimensional_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Dimensional_oM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Geometry_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Geometry_Engine.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Geometry_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Geometry_oM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Library_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Library_Engine.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Physical_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Physical_oM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Quantities_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Quantities_oM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Spatial_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Spatial_Engine.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Spatial_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Spatial_oM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Structure_AdapterModules">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Structure_AdapterModules.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Structure_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Structure_Engine.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Structure_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Structure_oM.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <!-- Deployment: the adapter and the Tekla Structural Designer API go to the BHoM assemblies folder,
       and the BCL shims that clash with other toolkits' copies go to a private subfolder served by
       Adapter/AssemblyResolver.cs. See "Deployment" in the README before changing this. -->
  <Target Name="CopyToBHoM" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' != 'Test'">
    <PropertyGroup>
      <BHoMAssembliesDir>$(ProgramData)\BHoM\Assemblies</BHoMAssembliesDir>
      <TsdPrivateDir>$(BHoMAssembliesDir)\TeklaStructuralDesigner</TsdPrivateDir>
    </PropertyGroup>

    <ItemGroup>
      <!-- The known clashes, listed so deployment does not depend on what else is installed. -->
      <TsdKnownPrivate Include="$(TargetDir)Microsoft.Bcl.AsyncInterfaces.dll;
                                $(TargetDir)Microsoft.Win32.Registry.dll;
                                $(TargetDir)System.Buffers.dll;
                                $(TargetDir)System.Memory.dll;
                                $(TargetDir)System.Numerics.Vectors.dll;
                                $(TargetDir)System.Runtime.CompilerServices.Unsafe.dll;
                                $(TargetDir)System.Threading.Tasks.Extensions.dll" />

      <!-- Everything else the SDK resolved, without the non-Windows gRPC natives. -->
      <TsdCandidateShared Include="$(TargetDir)**\*.*"
                          Exclude="$(TargetDir)**\TeklaStructuralDesigner_*;
                                   $(TargetDir)**\*.pdb;
                                   $(TargetDir)**\*.so;
                                   $(TargetDir)**\*.dylib;
                                   @(TsdKnownPrivate)" />

      <!-- Fail safe: any other clash is deployed privately rather than overwriting a shared copy. -->
      <TsdUnexpectedClash Include="@(TsdCandidateShared)"
                          Condition="'%(Extension)' == '.dll' And Exists('$(BHoMAssembliesDir)\%(Filename)%(Extension)')" />

      <TsdPrivateDependency Include="@(TsdKnownPrivate);@(TsdUnexpectedClash)" />
      <TsdSharedDependency Include="@(TsdCandidateShared)" Exclude="@(TsdUnexpectedClash)" />

      <!-- Private files left by a build against an earlier API package, which the resolver would serve. -->
      <TsdPrivateStale Include="$(TsdPrivateDir)\**\*.*"
                       Exclude="@(TsdPrivateDependency->'$(TsdPrivateDir)\%(Filename)%(Extension)')" />
    </ItemGroup>

    <!-- Flags a clash introduced by a package update. -->
    <Warning Condition="'@(TsdUnexpectedClash)' != ''"
             Text="These Tekla Structural Designer dependencies were about to be deployed top level but share a file name with an assembly already in $(BHoMAssembliesDir): @(TsdUnexpectedClash->'%(Filename)%(Extension)', ', '). They have been deployed to the private folder instead, leaving the shared copies untouched. Confirm that is right, and if it is, add them to TsdKnownPrivate so the decision is recorded rather than rediscovered." />

    <MakeDir Directories="$(TsdPrivateDir)" />
    <Delete Files="@(TsdPrivateStale)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BHoMAssembliesDir)" />
    <Copy SourceFiles="@(TsdSharedDependency)"
          DestinationFiles="@(TsdSharedDependency->'$(BHoMAssembliesDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TsdPrivateDependency)"
          DestinationFiles="@(TsdPrivateDependency->'$(TsdPrivateDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
